# Ownership routing for changes to the Loki trust and build boundaries.
# These entries request the maintainer's attention; Code Owner approval is
# not an enforced merge requirement. The sole-maintainer policy requires a
# protected pull request, current CI and resolved conversations, with zero
# mandatory human approvals. See docs/loki/PRODUCTION-READINESS.md.
#
# Last match wins; every rule below has the same owner, so order is moot.
# Patterns without a leading slash match at any depth.

# Workflows, composite actions, and this file decide what CI executes.
# The scripts the workflows run get the same ownership routing.
/.github/                       @ObliviousOdin
/scripts/ci/                    @ObliviousOdin
/scripts/loki/                  @ObliviousOdin
# The code-health gate decides whether a PR passes; weakening it is a CI change.
/scripts/check                  @ObliviousOdin
/scripts/code_health/           @ObliviousOdin

# The committed system prompt + tools[] render every session sends (scripts/ci/prompt_surface.py).
# Route prompt-surface changes to the Loki maintainer as well.
/tests/fixtures/prompt_surface/ @ObliviousOdin

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @ObliviousOdin
/.prettierrc                    @ObliviousOdin

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @ObliviousOdin
/hermes_cli/mcp_catalog.py      @ObliviousOdin

# Files that execute at pip-install or interpreter startup.
/setup.py                       @ObliviousOdin
/setup.cfg                      @ObliviousOdin
/sitecustomize.py               @ObliviousOdin
/usercustomize.py               @ObliviousOdin
*.pth                           @ObliviousOdin

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @ObliviousOdin
package.json                    @ObliviousOdin
uv.lock                         @ObliviousOdin
*package-lock.json              @ObliviousOdin
/flake.lock                     @ObliviousOdin
/pm/lock.json                   @ObliviousOdin
*Dockerfile                     @ObliviousOdin

# The npm supply-chain quarantine (min-release-age) lives here.
.npmrc                          @ObliviousOdin

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @ObliviousOdin
# Reviewed third-party source and deterministic archives are build inputs too.
/vendor/                        @ObliviousOdin

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @ObliviousOdin
/scripts/install.ps1            @ObliviousOdin
/scripts/install.cmd            @ObliviousOdin
/scripts/gen-bootstrap-pins.py  @ObliviousOdin

# The trust model and the scope authority for security reports.
/SECURITY.md                    @ObliviousOdin

# Each entry pins a third-party repo by sha; editing it changes what users install.
/plugin-catalog/                @ObliviousOdin
